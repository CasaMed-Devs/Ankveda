# Copy to .env.local.
# Which backend the app talks to: vercel | firebase | local
#  - vercel:   staging API on Vercel
#  - firebase: production API on Firebase Functions (Hosting rewrite)
#  - local:    Firebase emulator on your machine
EXPO_PUBLIC_API_TARGET=vercel

# Per-target base URLs (no trailing slash). Optional — defaults live in src/lib/config.ts.
EXPO_PUBLIC_API_URL_VERCEL=https://ankveda-backend.vercel.app/api
EXPO_PUBLIC_API_URL_FIREBASE=https://ankveda-e6471.web.app/api
# Emulator via USB: run `adb reverse tcp:5001 tcp:5001`. Android emulator: use 10.0.2.2; physical phone over Wi-Fi: your PC's LAN IP.
EXPO_PUBLIC_API_URL_LOCAL=http://127.0.0.1:5001/demo-ankveda/asia-south2/api

# Escape hatch: if set, this exact URL is used and EXPO_PUBLIC_API_TARGET is ignored.
# EXPO_PUBLIC_API_URL=

# Optional legal links shown on login / profile.
EXPO_PUBLIC_TERMS_URL=https://ankveda.app/terms
EXPO_PUBLIC_PRIVACY_URL=https://ankveda.app/privacy
