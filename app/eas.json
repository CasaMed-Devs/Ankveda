{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_TARGET": "vercel" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_TARGET": "vercel" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_API_TARGET": "firebase" }
    }
  }
}
