{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://ankveda-api-staging.vercel.app/api" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://ankveda-api-staging.vercel.app/api" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_API_URL": "https://ankveda-e6471.web.app/api" }
    }
  }
}
