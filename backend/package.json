{
  "name": "ankveda-backend",
  "private": true,
  "main": "lib/src/firebase.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/src/**/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting",
    "deploy:firebase": "firebase deploy --only functions",
    "deploy:staging": "vercel deploy --prod"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.62.0",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
