# Non-secret settings. Copy to backend/.env (deployed) or backend/.env.local (emulator only).

# Login codes: "dummy" = fixed code below, shown in the app (until a real SMS provider is added).
OTP_MODE=dummy
DUMMY_OTP=123456

# OpenAI model used to write report text and daily guidance (ChatGPT 4o mini).
OPENAI_MODEL=gpt-4o-mini

# Only for legacy astrologyapi.com plan keys (User ID + API key, HTTP Basic auth).
# Leave empty when using an access token ("ak-…"), which is sent as the x-astrologyapi-key header.
ASTROLOGY_API_USER_ID=

# Platform (set automatically on Vercel: staging + inline). Firebase production uses the trigger.
# APP_ENV=staging
# REPORT_RUNNER=inline          # inline (Vercel waitUntil) | trigger (Firebase Firestore trigger)
# FIRESTORE_DATABASE_ID=(default)
# CORS_ORIGINS=https://ankveda-e6471.web.app,https://ankveda-e6471.firebaseapp.com

# ── Login OTP by SMS (VoiceNSMS, DLT) ─────────────────────────────────────────
# OTP_MODE=sms is automatic once VOICENSMS_API_KEY, VOICENSMS_SEND_URL and VOICENSMS_MESSAGE are set.
VOICENSMS_TEMPLATE_ID=80388
VOICENSMS_SENDER_ID=HOTIPL
# Send URL copied from the VoiceNSMS dashboard (API section) with values replaced by placeholders:
#   {apiKey} {senderId} {templateId} {mobile} (10 digits) {mobile91} (91 + 10 digits) {message}
VOICENSMS_SEND_URL=
# Exact DLT-approved text of template 80388, with {otp} where the code goes.
VOICENSMS_MESSAGE=
# Optional: regex the response must match to count as sent (otherwise any 2xx without an error word).
# VOICENSMS_SUCCESS_PATTERN=
# Fixed-code numbers that never get an SMS (Play Store review / QA): "9000000001:482913"
# OTP_TEST_NUMBERS=
# OTP_DAILY_LIMIT=8
