# Emulator secrets. Copy to backend/.secret.local (git-ignored).
# In production set each one with:  firebase functions:secrets:set NAME
# Leave an integration empty to use its local mock (Astrology API / OpenAI); Razorpay must be set to test payments.

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

OPENAI_API_KEY=
# astrologyapi.com access token ("ak-…") — used for numerology and the Astro Chat API.
ASTROLOGY_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# VoiceNSMS login SMS key
VOICENSMS_API_KEY=
