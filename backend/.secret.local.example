# Emulator secrets. Copy to backend/.secret.local (git-ignored).
# In production set each one with:  firebase functions:secrets:set NAME
# Leave an integration empty to use its local mock (Astrology API / OpenAI); Razorpay must be set to test payments.

JWT_SECRET=change-me-to-a-long-random-string

OPENAI_API_KEY=
# astrologyapi.com access token ("ak-…") — used for numerology reports and daily guidance.
ASTROLOGY_API_KEY=

# Persona API key ("sk_live_…") — astrologer chat (personaapi.web.app). Server only, never in the app.
PERSONA_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# VoiceNSMS login SMS key
VOICENSMS_API_KEY=
